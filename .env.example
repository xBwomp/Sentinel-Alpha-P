# ── Coinbase CDP Credentials ──────────────────────────────────────────────────
# Get these from https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=       # PEM private key — use \n for newlines in single-line format
CDP_WALLET_SECRET=

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK_ID=base-mainnet   # base-mainnet or base-sepolia (testnet)
RPC_URL=                  # Optional: override public RPC (recommended: Alchemy/QuickNode free tier)

# ── Trading ───────────────────────────────────────────────────────────────────
DRY_RUN=true              # Set false to enable live on-chain swaps
Z_SCORE_THRESHOLD=2.0     # Base signal sensitivity
TRADE_SCALE_RAMP=1.0      # Z excess above threshold to reach max trade size (max at threshold + ramp)
WINDOW_SIZE_HOURS=48      # Rolling window for Z-Score calculation
TRADE_SIZE_PCT=0.10       # Base trade size as fraction of balance (at threshold)
TRADE_SIZE_MAX_PCT=0.40   # Max trade size at extreme Z-scores
DAILY_STOP_LOSS_PCT=0.05  # Portfolio drawdown fraction that halts the agent
SWAP_SLIPPAGE_BPS=200     # Swap slippage tolerance in basis points

# ── Risk / Signal Filters ─────────────────────────────────────────────────────
ADAPTIVE_THRESHOLD_WINDOW=12   # Price points (~1hr) used for volatility regime detection
COINT_P_THRESHOLD=0.25         # Max cointegration p-value to allow trading
COINT_MIN_POINTS=20            # Min price points before cointegration check runs

# ── Aave V3 Yield on Idle ETH (Base mainnet only) ────────────────────────────
# Verify addresses on Basescan before enabling
# AAVE_AWETH_ADDRESS should show "Aave: aBasWETH Token" on Basescan
AAVE_ENABLED=false
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
AAVE_AWETH_ADDRESS=0xD4a0e0b9149BCee3C920d2E00b5dE09138fd8bb7
AAVE_ETH_RESERVE=0.001    # ETH kept liquid for gas, not deposited
AAVE_MIN_DEPOSIT=0.005    # Min idle ETH before depositing to Aave

# ── Telegram Notifications ────────────────────────────────────────────────────
# Leave blank to disable. Setup: message @BotFather on Telegram to create a bot.
# Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates after messaging your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Persistence ───────────────────────────────────────────────────────────────
WALLET_DATA_FILE=wallet_data.json
LOG_FILE=trading_log.txt
TRADES_FILE=trades.json
DAILY_SUMMARY_FILE=daily_summary.json
