# Network Configuration
NETWORK_ID=base-mainnet
# Override the default public RPC (mainnet.base.org hits 429 rate limits).
# Use a dedicated endpoint from Alchemy, Infura, QuickNode, etc.
# Example: RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://base.publicnode.com

# Trading configuration
TRADING_PAIR=BTC-USD
DRY_RUN=false
PRICE_POLL_SECONDS=60
WINDOW_SIZE_HOURS=48
Z_SCORE_THRESHOLD=2.0
TRADE_SIZE_PCT=0.10
TRADE_SIZE_MAX_PCT=0.40
